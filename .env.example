# Shopify App 凭证（Dev Dashboard → 你的 App → Settings → Credentials）
SHOPIFY_API_KEY=0dce9a73d4a5e8536ff17c7c446d5273
SHOPIFY_API_SECRET=your_client_secret_here
SCOPES=read_orders

# 部署后的公网地址（必须与 shopify.app.toml 里的 application_url / redirect_urls 一致）
SHOPIFY_APP_URL=https://chinapass.onrender.com

# Postgres 连接串（Render Postgres 或 Neon 免费库）
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# 运行时
NODE_ENV=production
PORT=3000
